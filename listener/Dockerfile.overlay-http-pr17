FROM ghcr.io/thalovant/hivemind-listener:bench-pr145-http17-20260709-2058@sha256:dfdfa72bf296713befd27e9f062a7018e05290b801f8d70d0f6d05063ac122b1

ARG USER=hivemind
ARG VERSION=unknown
ARG GIT_SHA=unknown

LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}"

USER root

COPY files/hivemind_http_protocol-0.0.4a1-py3-none-any.whl /tmp/hivemind_http_protocol-0.0.4a1-py3-none-any.whl

RUN "/home/${USER}/.venv/bin/python" -m pip install --no-cache-dir "redis>=4.5.0" \
 && "/home/${USER}/.venv/bin/python" -m pip install --no-cache-dir --no-deps --force-reinstall \
      /tmp/hivemind_http_protocol-0.0.4a1-py3-none-any.whl \
 && "/home/${USER}/.venv/bin/python" -m pip check \
 && "/home/${USER}/.venv/bin/python" -c "\
import inspect; \
import importlib.metadata as metadata; \
import redis; \
from packaging.version import Version; \
from hivemind_http_protocol import ClientDatabaseSync, HiveMindHttpHandler, RedisHttpSessionState, _redis_config_from_server, _redis_session_prefix_from_config; \
assert Version(metadata.version('hivemind-http-protocol')) >= Version('0.0.4a1'); \
assert isinstance(HiveMindHttpHandler.db_sync, ClientDatabaseSync); \
assert RedisHttpSessionState; \
assert _redis_config_from_server; \
assert _redis_session_prefix_from_config({'index_prefix': 'hub-prefix'}) == 'hub-prefix:hivemind-http'; \
source = inspect.getsource(HiveMindHttpHandler.get_client); \
assert 'get_client_by_api_key(key)' in source; \
assert 'db_sync.sync' in source; \
assert source.index('get_client_by_api_key(key)') < source.index('db_sync.sync'); \
print('http PR17 overlay checks passed', metadata.version('hivemind-http-protocol'), redis.__version__)" \
 && rm -f /tmp/hivemind_http_protocol-0.0.4a1-py3-none-any.whl

USER "$USER"
